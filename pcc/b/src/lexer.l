%{
#include "y.tab.h" // tokens generated by yacc
#include <stdlib.h>

// The below 'option' call voids some unused functions
// Older versions of lex might not recognize this line
%}

%option nounput noinput

%%

"auto"                     { return AUTO; }
"extrn"                    { return EXTERN; }
"while"                    { return WHILE; }
"if"                       { return IF; }
"else"                     { return ELSE; }
"return"                   { return RETURN; }

[a-zA-Z_][a-zA-Z0-9_]*     { // Variables
                             yylval.str = strdup(yytext);
                             return IDENTIFIER; 
                           }

[0-9]+                     { // Numbers
                             yylval.num = atoi(yytext); 
                             return NUMBER; 
                           }

'(\\.|[^\\'])'             { // Chars
                             if (yytext[1] == '\\') {
                               if (yytext[2] == 'n') yylval.num = '\n';
                               else if (yytext[2] == 't') yylval.num = '\t';
                               else if (yytext[2] == '0') yylval.num = '\0';
                               else yylval.num = yytext[2];
                             } else {
                               yylval.num = (unsigned char)yytext[1];
                             }
                             return NUMBER;
                           }

\"([^\"\\]|\\.)*\"         { // Strings
                             yylval.str = strdup(yytext);
                             return STRING;
                           }

[ \t\n]+                   { /* Ignore whitespaces */ }

"/*"([^*]|\*+[^*/])*\*+"/" { /* Ignore comments */ }

";"                        { return SEMICOLON; }
","                        { return COMMA; }
"("                        { return PAROPEN; }
")"                        { return PARCLOSE; }
"{"                        { return BRACEOPEN; }
"}"                        { return BRACECLOSE; }
"["                        { return ARROPEN; }
"]"                        { return ARRCLOSE; }

"=="                       { return EQUALS; }
"!="                       { return NOTEQUALS; }
"<="                       { return LOWEREQ; }
"<"                        { return LOWER; }
">="                       { return HIGHEREQ; }
">"                        { return HIGHER; }

"="                        { return EQUAL; }
"!"                        { return NOT; }
"~"                        { return BITNOT; }
"&&"                       { return AND; }
"&"                        { return BITAND; }
"||"                       { return OR; }
"|"                        { return BITOR; }
"^"                        { return XOR; }
"<<"                       { return LSHIFT; }
">>"                       { return RSHIFT; }

"++"                       { return INCREMENT; }
"--"                       { return DECREMENT; }
"+"                        { return PLUS; }
"-"                        { return MINUS; }
"*"                        { return STAR; }
"/"                        { return DIV; }
"%"                        { return MOD; }

%%

int yywrap() {
    return 1;
}
