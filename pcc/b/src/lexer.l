%{
#include "y.tab.h" // tokens generated by yacc
#include <stdlib.h>

// The below 'option' call voids some unused functions
// Older versions of lex might not recognize this line
%}

%option nounput noinput

%%

"auto"                     { return TOK_AUTO; }
"extrn"                    { return TOK_EXTERN; }
"while"                    { return TOK_WHILE; }
"if"                       { return TOK_IF; }
"else"                     { return TOK_ELSE; }
"goto"                     { return TOK_GOTO; }
"return"                   { return TOK_RETURN; }
"switch"                   { return TOK_SWITCH; }
"case"                     { return TOK_CASE; }
"default"                  { return TOK_DEFAULT; }
"break"                    { return TOK_BREAK; }

[a-zA-Z_][a-zA-Z0-9_]*     { // Variables
                             yylval.str = strdup(yytext);
                             return TOK_IDENT; 
                           }

[0-9]+                     { // Numbers
                             yylval.num = atoi(yytext); 
                             return TOK_NUM; 
                           }

[0-9]+\.[0-9]+             { // Floating-point numbers
                             // Convert into raw IEEE-754 bits
                             float f = atof(yytext);
                             unsigned int bits;
                             memcpy(&bits, &f, sizeof(bits));
                             yylval.num = bits;
                             return TOK_NUM;
                           }

'(\\.|[^\\'])'             { // Chars
                             if (yytext[1] == '\\') {
                               if (yytext[2] == 'n') yylval.num = '\n';
                               else if (yytext[2] == 't') yylval.num = '\t';
                               else if (yytext[2] == '0') yylval.num = '\0';
                               else yylval.num = yytext[2];
                             } else {
                               yylval.num = (unsigned char)yytext[1];
                             }
                             return TOK_NUM;
                           }

\"([^\"\\]|\\.)*\"         { // Strings
                             yylval.str = strdup(yytext);
                             return TOK_STR;
                           }

[ \t\n]+                   { /* Ignore whitespaces */ }

"/*"([^*]|\*+[^*/])*\*+"/" { /* Ignore comments */ }

";"                        { return TOK_SEMI; }
":"                        { return TOK_COL; }
","                        { return TOK_COMMA; }
"("                        { return TOK_LPAREN; }
")"                        { return TOK_RPAREN; }
"{"                        { return TOK_LBRACE; }
"}"                        { return TOK_RBRACE; }
"["                        { return TOK_LBRACKET; }
"]"                        { return TOK_RBRACKET; }
"<"                        { return TOK_LANGLE; }
">"                        { return TOK_RANGLE; }
"<<"                       { return TOK_LSHIFT; }
">>"                       { return TOK_RSHIFT; }

"=="                       { return TOK_EQ; }
"!="                       { return TOK_NEQ; }
"<="                       { return TOK_LTE; }
">="                       { return TOK_GTE; }

"="                        { return TOK_ASSIGN; }
"!"                        { return TOK_EXCL; }
"~"                        { return TOK_TILDE; }
"&&"                       { return TOK_DBL_AMPER; }
"&"                        { return TOK_AMPER; }
"||"                       { return TOK_DBL_PIPE; }
"|"                        { return TOK_PIPE; }
"^"                        { return TOK_CARRET; }

"#+"                       { return TOK_FPLUS; }
"#-"                       { return TOK_FMINUS; }
"#*"                       { return TOK_FMULT; }
"#/"                       { return TOK_FDIV; }
"#<"                       { return TOK_FLT; }
"#>"                       { return TOK_FGT; }
"#=="                      { return TOK_FEQ; }
"#!="                      { return TOK_FNEQ; }
"#<="                      { return TOK_FLTE; }
"#>="                      { return TOK_FGTE; }
"##"                       { return TOK_HASH_HASH; }
"#"                        { return TOK_HASH; }

"++"                       { return TOK_INCREMENT; }
"--"                       { return TOK_DECREMENT; }
"+"                        { return TOK_PLUS; }
"-"                        { return TOK_MINUS; }
"*"                        { return TOK_STAR; }
"/"                        { return TOK_DIV; }
"%"                        { return TOK_MOD; }

%%

int yywrap() {
    return 1;
}
