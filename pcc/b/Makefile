NAME := B
CC := gcc
CFLAGS := -Wall -Wextra -Werror -g3 -I. -Isrc

SRC := symtab.c main.c asm.c
SRC += y.tab.c lex.yy.c
SRC := $(addprefix src/, $(SRC))
OBJ := $(SRC:.c=.o)

GRNHB := \e[1;102;30m
YELHB := \e[1;103;30m
MAGHB := \e[1;105;30m
CRESET := \e[0m

all: $(NAME)

$(NAME): $(OBJ)
	@printf "$(GRNHB) CC $(CRESET) $^\n"
	@$(CC) $(CFLAGS) -o $@ $^
	@printf "$(GRNHB)    $(CRESET) $@\n"

%.o: %.c
	@printf "$(YELHB) CC $(CRESET) $<\n"
	@$(CC) -c $< $(CFLAGS) -o $@

# Prevents race condition where any header compiles
# before y.tab.h has been generated by yacc
$(OBJ): src/y.tab.h

src/y.tab.c src/y.tab.h: src/parser.y
	@printf "$(MAGHB) YY $(CRESET) $<\n"
	@yacc -d src/parser.y -o src/y.tab.c

src/lex.yy.c: src/lexer.l src/y.tab.h
	@printf "$(MAGHB) LX $(CRESET) $<\n"
	@lex -o src/lex.yy.c src/lexer.l

clean:
	@rm -fv $(OBJ) src/y.tab.c src/y.tab.h src/lex.yy.c

fclean: clean
	@rm -fv $(NAME)

bonus: all

re: fclean all

.PHONY: all bonus clean fclean re
