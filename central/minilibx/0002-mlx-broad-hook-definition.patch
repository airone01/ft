-    mlx_int_param_generic,      mlx_int_param_generic,
-    mlx_int_param_generic,      mlx_int_param_generic,
-    mlx_int_param_generic,      mlx_int_param_generic,
-    mlx_int_param_generic,      mlx_int_param_generic,
-    mlx_int_param_generic,      mlx_int_param_generic,
-    mlx_int_param_generic,      mlx_int_param_generic,
-    mlx_int_param_generic,      mlx_int_param_generic,
-    mlx_int_param_generic,      mlx_int_param_generic,
-    mlx_int_param_generic,      mlx_int_param_generic,
-    mlx_int_param_generic,      mlx_int_param_generic,
-    mlx_int_param_generic,      mlx_int_param_generic,
-    mlx_int_param_generic};
+    (int (*)())mlx_int_param_undef, /* 0 */
+    (int (*)())mlx_int_param_undef,
+    (int (*)())mlx_int_param_KeyPress,
+    (int (*)())mlx_int_param_KeyRelease, /* 3 */
+    (int (*)())mlx_int_param_ButtonPress,
+    (int (*)())mlx_int_param_ButtonRelease,
+    (int (*)())mlx_int_param_MotionNotify, /* 6 */
+    (int (*)())mlx_int_param_generic,
+    (int (*)())mlx_int_param_generic,
+    (int (*)())mlx_int_param_generic,
+    (int (*)())mlx_int_param_generic,
+    (int (*)())mlx_int_param_generic,
+    (int (*)())mlx_int_param_Expose, /* 12 */
+    (int (*)())mlx_int_param_generic,
